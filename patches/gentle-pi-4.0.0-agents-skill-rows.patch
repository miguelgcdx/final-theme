+			if (parts.some((part) => part === "" || part === "." || part === "..")) continue;
+			const name = parts[parts.length - 2];
+			if (!name || !SKILL_NAME.test(name) || name.includes("..") || seen.has(name.toLowerCase())) continue;
+			seen.add(name.toLowerCase());
+			names.push(name);
+			if (names.length === SKILLS_MAX) return names;
+		}
+	}
+	return names;
+}
