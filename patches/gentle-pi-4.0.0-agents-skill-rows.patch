+const SKILLS_MAX = 4;
+const SKILL_NAME = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/;
+
+/** Safe fallback for legacy records and untrusted persisted display metadata. */
+export function boundedSkillNames(value: unknown): string[] {
+	if (!Array.isArray(value)) return [];
+	const names: string[] = [];
+	const seen = new Set<string>();
+	for (const name of value.slice(0, SKILLS_MAX)) {
+		if (typeof name !== "string" || !SKILL_NAME.test(name) || name.includes("..") || seen.has(name.toLowerCase())) continue;
+		seen.add(name.toLowerCase());
+		names.push(name);
+	}
+	return names;
+}
+
+/** Parse assignment sections only, without reading/resolving any supplied path. */
+export function assignedSkillNames(prompt: string, context?: string): string[] {
+	const names: string[] = [];
+	const seen = new Set<string>();
+	for (const source of [prompt, context]) {
+		// Reject oversized inputs instead of cutting into a comment/fence/path.
+		if (!source || source.length > 65_536) continue;
+		let section = false;
+		let comment = false;
+		let untrusted = false;
+		let fence: { marker: string; length: number } | undefined;
+		for (const line of source.split(/\r?\n/).slice(0, 1024)) {
+			if (line.length > 2048) break;
+			const delimiter = /^ {0,3}(`{3,}|~{3,})(.*)$/.exec(line);
+			if (fence) {
+				if (delimiter && delimiter[1][0] === fence.marker && delimiter[1].length >= fence.length && delimiter[2].trim() === "") fence = undefined;
+				continue;
+			}
+			// Already-open blocks own the whole line, including apparent boundaries.
+			if (comment) {
+				if (line.includes("-->")) comment = false;
+				if (line.lastIndexOf("<!--") > line.lastIndexOf("-->")) comment = true;
+				continue;
+			}
+			if (untrusted) {
+				untrusted = !/<\/untrusted(?:_text)?\s*>/i.test(line);
+				continue;
+			}
+			// Visible fence openers and section boundaries take precedence over
+			// newly appearing comments; comment-bearing path entries still fail closed.
+			if (delimiter) {
+				fence = { marker: delimiter[1][0], length: delimiter[1].length };
+				continue;
+			}
+			// ATX headings (including 1–3 space indentation) and setext headings
+			// terminate the section; indented headings cannot start an assignment.
+			if (section && (/^ {0,3}#{1,6}(?:[ \t]|$)/.test(line) || /^ {0,3}(?:=+|-+)[ \t]*$/.test(line))) break;
+			if (line.includes("<!--")) {
+				comment = line.lastIndexOf("<!--") > line.lastIndexOf("-->");
+				continue;
+			}
+			if (/<untrusted(?:_text)?\b/i.test(line)) {
+				untrusted = !/<\/untrusted(?:_text)?\s*>/i.test(line);
+				continue;
+			}
+			if (!section) {
+				if (/^## Skills to load before work[ \t]*$/.test(line)) section = true;
+				continue;
+			}
+			const entry = /^ {0,3}(?:[-*+] +)?(?:`([^`]+)`|([^\s`]+))[ \t]*$/.exec(line);
+			const path = entry?.[1] ?? entry?.[2];
