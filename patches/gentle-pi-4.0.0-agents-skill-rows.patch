+// Spend physical body rows on indivisible identity/skill pairs. Reserve the
+// existing overflow line before selecting by status priority, then draw the
+// selected prefix in start order. A one-row budget can show only overflow.
+function skillVisibleRows(shown: readonly TaskRecord[], budget: number, collapsed: boolean): { listed: TaskRecord[]; hidden: number } {
+	const cost = (task: TaskRecord) => skillLabel(task) ? 2 : 1;
+	if (collapsed) {
+		const first = shown[0];
+		// The existing expansion hint accounts for the remaining collapsed tasks.
+		return first && cost(first) <= budget ? { listed: [first], hidden: 0 } : { listed: [], hidden: shown.length };
+	}
+	const candidates = [...shown].sort((a, b) => SHOW_PRIORITY[a.status] - SHOW_PRIORITY[b.status] || startOrder(a, b));
+	if (candidates.reduce((sum, task) => sum + cost(task), 0) <= budget) return { listed: [...shown], hidden: 0 };
+	const listed: TaskRecord[] = [];
+	let remaining = budget - 1;
+	for (const task of candidates) {
+		if (cost(task) > remaining) break;
+		listed.push(task);
+		remaining -= cost(task);
+	}
+	return { listed: listed.sort(startOrder), hidden: shown.length - listed.length };
+}
